# Copia a .env para desarrollo local. Las plantillas por servicio para Coolify viven en deploy/.
NODE_ENV=development
LOG_LEVEL=debug

# pos-api
API_PORT=3000
# Rol dueño: migraciones (prisma migrate) y semillas. Bypassa RLS por ser dueño de las tablas.
DATABASE_URL=postgresql://posbar:posbar@localhost:5432/posbar
# Rol de aplicación (fase 02, sin BYPASSRLS): el único que usa TenantPrismaService en runtime.
DATABASE_APP_URL=postgresql://posbar_app:posbar_app_dev@localhost:5432/posbar
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

# pos-web (variables de compilación de Vite)
VITE_API_URL=http://localhost:3000
