# Servicio Coolify: pos-api  (Dockerfile: deploy/api/Dockerfile, comando por defecto)
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3000
APP_VERSION=0.1.0
# Usar los nombres internos de los servicios postgres y redis de Coolify
# Rol dueño: migraciones/semillas. Bypassa RLS por ser dueño de las tablas.
DATABASE_URL=postgresql://posbar:CAMBIAR@postgres:5432/posbar
# Rol de aplicación (fase 02, sin BYPASSRLS): el único que usa la API en runtime.
# Creado por la migración init_tenancy con clave de desarrollo; rotarla aquí y con
# ALTER ROLE posbar_app PASSWORD 'nueva' en el postgres real antes de ir a producción.
DATABASE_APP_URL=postgresql://posbar_app:CAMBIAR@postgres:5432/posbar
REDIS_URL=redis://redis:6379
# Dominio público de pos-web (varios separados por coma)
CORS_ORIGIN=https://pos.ejemplo.com
